{
  "name": "tinyurl",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Distributed URL shortening service",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "test": "bun test tests/unit",
    "typecheck": "tsc --noEmit",
    "loadtest": "k6 run loadtest/redirect.js",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test:integration": "bun test tests/integration --timeout 30000",
    "test:all": "bun run test && bun run test:integration"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/core": "^3.0.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.44.0",
    "hono": "^4.13.14",
    "ioredis": "^6.0.0",
    "mongodb": "^7.7.0",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/bun": "^1.4.4",
    "pino-pretty": "^13.2.0",
    "typescript": "^7.0.2"
  }
}
