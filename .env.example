NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
LOG_LEVEL=info

MONGO_URI=mongodb://localhost:27017
MONGO_DB=tinyurl
MONGO_MAX_POOL_SIZE=100

REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=86400
NEGATIVE_CACHE_TTL_SECONDS=60

CODE_LENGTH=7
ID_BLOCK_SIZE=1000

ANALYTICS_BATCH_SIZE=500
ANALYTICS_FLUSH_INTERVAL_MS=1000
ANALYTICS_MAX_BUFFER=50000
CLICK_RETENTION_DAYS=90

RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SECONDS=60

# When set, /api/v1 endpoints require the x-api-key header.
# API_KEY=change-me

# Honour x-forwarded-for (last hop) for rate limiting. Enable only behind a trusted load balancer.
TRUST_PROXY=false
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RESET_MS=10000
SHUTDOWN_GRACE_MS=0
SHUTDOWN_TIMEOUT_MS=15000
