{
  "family": "tinyurl",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/tinyurl-execution",
  "taskRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/tinyurl-task",
  "containerDefinitions": [
    {
      "name": "app",
      "image": "<ACCOUNT_ID>.dkr.ecr.<REGION>.amazonaws.com/tinyurl:<TAG>",
      "essential": true,
      "portMappings": [{ "containerPort": 3000, "protocol": "tcp" }],
      "stopTimeout": 30,
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "BASE_URL", "value": "https://<YOUR_SHORT_DOMAIN>" },
        { "name": "TRUST_PROXY", "value": "true" },
        { "name": "SHUTDOWN_GRACE_MS", "value": "5000" },
        { "name": "SHUTDOWN_TIMEOUT_MS", "value": "25000" },
        { "name": "OTEL_EXPORTER_OTLP_ENDPOINT", "value": "http://localhost:4318" }
      ],
      "secrets": [
        { "name": "MONGO_URI", "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:tinyurl/mongo-uri" },
        { "name": "REDIS_URL", "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:tinyurl/redis-url" },
        { "name": "API_KEY", "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:tinyurl/api-key" }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "bun -e \"fetch('http://localhost:3000/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\""],
        "interval": 15,
        "timeout": 3,
        "retries": 3,
        "startPeriod": 20
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/tinyurl",
          "awslogs-region": "<REGION>",
          "awslogs-stream-prefix": "app"
        }
      }
    }
  ]
}
